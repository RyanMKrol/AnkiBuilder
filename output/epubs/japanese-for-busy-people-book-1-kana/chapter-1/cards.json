    {
      "id": "o-prefix",
      "english": "(Honorific prefix)",
      "category": "Grammar & Function Words",
      "target": "お",
      "pronunciation": "o",
      "audio": "o-prefix-manual-aa90e4bb.mp3",
      "altAudio": "762c1a1a571413e6.mp3",
      "note": "お (o) is not a word on its own — it's a short prefix stuck onto the FRONT of certain nouns to make them sound more polite/respectful. It's used almost entirely for things belonging to the person you're talking to (or a third person), not your own things — e.g. お (o) + くに (kuni) ('country') → おくに (okuni) ('your country'), heard in this chapter's own dialogue: スミスさん、おくには どちらですか。 (Sumisu-san, okuni wa dochira desu ka?) ('Smith-san, what country are you from?'). Think of it like the difference between 'your country' (plain) and a more deferential way of asking about someone else's country in English — お (o) signals that same extra politeness, just attached directly to the front of the word instead of being a separate word.",
      "audioOriginal": "dd250649cc4ac044.orig.mp3",
      "audioAuto": "dd250649cc4ac044.mp3",
      "audioFilter": "standard",
      "audioMarked": true,
      "audioManual": "o-prefix-manual-aa90e4bb.mp3",
      "audioTrim": {
        "start": 0.08495890410958905,
        "end": 0.37200684931506856
      },
      "hint": "the prefix on native words like なまえ (namae) and みやげ (miyage)",
      "audioTextHash": "dd250649cc4ac044"
    },
