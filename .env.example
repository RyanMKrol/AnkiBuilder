# AnkiBuilder — local environment template.
# Copy this to `.env` and fill in the values:  cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed. The tool reads these from the
# environment only and never writes secrets to disk. Every CLI command loads the
# package root's `.env` when present (variables already set in the environment win),
# so you don't have to export by hand or run from a particular directory.

# ── Required ────────────────────────────────────────────────────────────────────

# Audio stage (ElevenLabs TTS). Get a key at https://elevenlabs.io.
ELEVENLABS_API_KEY=

# ── Voice / TTS (optional) ──────────────────────────────────────────────────────

# The ElevenLabs voice id to speak cards with (else chosen per run / per language).
# ELEVENLABS_VOICE_ID=

# TTS model (default eleven_v3). The audio cache is segmented by model, so changing
# this regenerates clips rather than reusing old ones.
# ANKI_BUILDER_TTS_MODEL=eleven_v3

# Override the per-language TTS end marker (Japanese default: 。ででで — gives the
# voice a sentence boundary, then gets trimmed off the clip). Rarely needed.
# ANKI_BUILDER_TTS_END_MARKER=

# ── Audio cleanup / trimming (optional) ─────────────────────────────────────────

# Automatic trailing-silence/blip trimming of ElevenLabs clips needs a system ffmpeg
# (brew install ffmpeg). Best-effort — audio still builds without it. 0 disables.
# ANKI_BUILDER_TRIM_AUDIO=1

# Background-noise cleanup chain applied before the trim: standard (default),
# gentle, aggressive, or off.
# ANKI_BUILDER_AUDIO_CLEANUP=standard

# Silence-detection tuning for the automatic trim (defaults are fine).
# ANKI_BUILDER_TRIM_SILENCE_DB=
# ANKI_BUILDER_TRIM_MIN_SILENCE_SEC=
# ANKI_BUILDER_TRIM_MIN_SPEECH_SEC=
# ANKI_BUILDER_TRIM_PAD_SEC=

# ── LLM passes (optional) ───────────────────────────────────────────────────────

# Model/effort for EVERY `claude -p` pass in the pipeline (default: claude-sonnet-5
# at medium effort). See src/util/runClaude.js.
# ANKI_BUILDER_LLM_MODEL=claude-sonnet-5
# ANKI_BUILDER_LLM_EFFORT=medium

# Per-family overrides — these win over the unified pair above when set.
# Translate family: translation, romanization eval, semantic de-dup, cross-lesson
# notes, number readings, kanji orthography.
# ANKI_BUILDER_TRANSLATE_MODEL=
# ANKI_BUILDER_TRANSLATE_EFFORT=
# EPUB family: chapter extraction, book conventions, taught index, forward flags,
# fill-in-the-blank mining, pedagogical sort.
# ANKI_BUILDER_EPUB_LLM_MODEL=
# ANKI_BUILDER_EPUB_LLM_EFFORT=

# Hard ceiling on one `claude -p` call (milliseconds; default 600000 = 10 min).
# ANKI_BUILDER_LLM_TIMEOUT_MS=600000

# ── Misc (optional) ─────────────────────────────────────────────────────────────

# Where the deliver-to-anki script looks for built decks (default: output).
# ANKI_BUILDER_OUTPUT_ROOT=output

# Backup retention for deliver-to-anki snapshots under anki-backups/: keep the
# newest N (default 10) plus the newest snapshot of each older week.
# ANKI_BUILDER_BACKUP_KEEP=10

# Test-only escape hatch: allow real model calls under the test runner.
# Never needed in normal use.
# ANKI_BUILDER_ALLOW_LLM_IN_TESTS=

# Local library state (audio cache, EPUB registry, taught index) lives in
# .anki-builder/ inside this checkout, gitignored — nothing to configure there.
